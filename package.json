{
  "name": "libredb-studio",
  "version": "0.1.0",
  "description": "OpenShift web console plugin that lists the cluster's databases and opens them in LibreDB Studio",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/libredb/libredb-studio-openshift-plugin.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "start": "yarn webpack serve --progress",
    "start-console": "./start-console.sh",
    "i18n": "./i18n-scripts/build-i18n.sh && node ./i18n-scripts/set-english-defaults.js",
    "lint": "eslint src tests integration-tests --max-warnings 0 && stylelint 'src/**/*.css' --allow-empty-input --max-warnings 0",
    "lint:fix": "eslint src tests integration-tests --fix --max-warnings 0 && stylelint 'src/**/*.css' --allow-empty-input --max-warnings 0 --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p integration-tests/tsconfig.json",
    "test": "LANG=en_US.UTF-8 jest",
    "test:coverage": "LANG=en_US.UTF-8 jest --coverage",
    "test:manifest": "LANG=en_US.UTF-8 jest --config jest.build.config.ts",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.19.1",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.19.0",
    "@patternfly/react-core": "6.2.3",
    "@patternfly/react-icons": "6.2.2",
    "@patternfly/react-styles": "6.2.2",
    "@patternfly/react-table": "6.2.3",
    "@patternfly/react-tokens": "6.2.2",
    "@playwright/test": "^1.60.0",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "8.20.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "12.1.5",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^17.0.37",
    "@types/react-router-dom": "^5.3.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.4.0",
    "i18next": "23.16.8",
    "i18next-parser": "^9.4.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pluralize": "^8.0.0",
    "prettier": "^3.8.1",
    "prettier-stylelint": "^0.4.2",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-i18next": "11.18.6",
    "react-router": "5.3.x",
    "react-router-dom": "5.3.x",
    "react-router-dom-v5-compat": "^6.11.2",
    "style-loader": "^4.0.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3",
    "yaml": "^2.9.1"
  },
  "resolutions": {
    "@patternfly/react-core": "6.2.3",
    "@patternfly/react-table": "6.2.3",
    "@patternfly/react-icons": "6.2.2",
    "@patternfly/react-styles": "6.2.2",
    "@patternfly/react-tokens": "6.2.2"
  },
  "consolePlugin": {
    "name": "libredb-studio",
    "version": "0.1.0",
    "displayName": "LibreDB Studio",
    "description": "Lists the cluster's databases and opens them in LibreDB Studio.",
    "exposedModules": {
      "DatabasesPage": "./components/DatabasesPage",
      "DatabaseDetailsItem": "./components/DatabaseDetailsItem"
    },
    "dependencies": {
      "@console/pluginAPI": ">=4.19.0-0"
    }
  },
  "packageManager": "yarn@4.13.0"
}
